----------------------------------------------------------
# IMPORTANT: The configs will not apply by default! Remove ? on start of each configs to apply.

# MIXINS
 ?enableWackySplashes: true

----------------------------------------------------------
# OVERRIDE
 # LCA is meant for people who love CE but also used to EE
 ?ovr_enableBlockReplacement: true

 # 1.7 behavior sucks
 ?ovr_holdDoorRedstone: true

 # Disable this if you love crashes
 ?ovr_safeCommit: true

----------------------------------------------------------
# OVERWRITES AND REPLACEMENTS (GAMEPLAY)
 # Enable this if you would like the DFC to have the NTMain behavior
 ?disableAddonDFC: false

 # Enable this if you would like the PWR to have the NTMain behavior
 ?disableAddonPWR: false

 # Enable this if you would like the ZIRNOX to have the NTMain behavior
 ?disableAddonZIRNOX: false

----------------------------------------------------------
# GENERAL
 # How far DFC components can reach
 ?dfcComponentRange: 50

 # Whether the barrels should have side ports or not
 ?enableBarrelSidePorts: true

 # Replaces item radiations with LCE radiations
 ?enableRadClassification: true

 # How long the placer of Meteor Protection Beacon has to be alive (in seconds)
 ?meteorDiverterMinAliveTime: 1800

 # How far the Meteor Protection Beacon should protect (in chunks)
 ?meteorDiverterProtectionRadius: 3

 # Whether meteors should create custom craters or not
 ?enableMeteorCraters: true

 # Whether the modular turbine RPS should be capped or not
 ?enableGovernedRPS: true
 ?minimumGovernedRPS: 60.0

 # How many blades there can be per side until turbulence skyrockets
 ?maxOptimalTurbineLength: 5

 # Multiplier of steam input surge turbulence for modular turbines
 ?surgeTurbulenceMultiplier: 1.0

 # Every biome acts like the digamma crater biome
 ?enableSchizoMode: false

 # (WIP) Changes this mod from using units you know to some bullshit units that god knows
 ?enableSludgeUnits: false

 # Whether floating blocks and weirdly built buildings should collapse or not (WARNING: VERY LAGGY & CHALLENGING!)
 ?enableStructuralIntegrity: false

 # IC10 nodes will throw StackOverflow when stack count exceeds this number
 ?ic10maxstack: 512

 # IC10 nodes will throw OutOfRegisterBounds when register index exceeds this number
 ?ic10maxregisters: 64

----------------------------------------------------------
# CLIENT
 # Disables shaders used by this addon. This may make it compatible with Vivecraft
 ?disableLCAShaders: false

----------------------------------------------------------
